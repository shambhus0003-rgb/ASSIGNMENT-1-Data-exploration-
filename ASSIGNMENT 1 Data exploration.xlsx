.insert-media-panel { height: clamp(300px, 550px, 90vh); }

.keep-focus-start { position: absolute; top: -1000px; }

.keep-focus { position: absolute; top: 1000px; }

.display-none { display: none; }

.padding-zero { padding: 0px; }
