.obf-OverallAnchor.obf-OverallAnchorActive { outline: rgba(0, 0, 0, 0) solid 2px; }

.obf-OverallAnchor.obf-OverallAnchorActive:hover { outline: rgb(0, 0, 0) dashed 2px; }

.obf-OverallAnchor.obf-OverallAnchorActive:focus { outline: rgb(0, 0, 0) dashed 2px; }

