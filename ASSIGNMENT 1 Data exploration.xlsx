.ewa-dv { position: relative; z-index: 100; width: auto; }

.ewa-dv-buttonarea { position: absolute; border: 0px; z-index: 100; margin: 0px; overflow: hidden; width: auto; height: auto; }

.ewa-dv-listbutton { margin: 0px; cursor: pointer; }

.ewa-dv-listbutton span.clip17x17 { display: inline-block; margin: 0px; }

.ewa-dlb { position: absolute; border: 1px solid rgb(162, 166, 171); overflow: hidden auto; cursor: default; background-color: rgb(255, 255, 255); color: rgb(68, 68, 68); font-size: 11px; z-index: 100; height: auto; margin: 0px; }

.ewa-dlb table { left: 0px; right: 0px; border-collapse: collapse; empty-cells: show; }

.ewa-dlb table td { white-space: nowrap; padding: 0px 2px; }

.ewa-dlb table.list-table td.list-item { height: 24px; }

.ewa-dlb table.list-table td.list-item-selected { height: 24px; background-color: rgb(211, 240, 224); color: rgb(68, 68, 68); }

.ewa-dlb table.list-table-touch td.list-item { height: 35px; }

.ewa-dlb table.list-table-touch td.list-item-selected { height: 35px; background-color: rgb(211, 240, 224); color: rgb(68, 68, 68); }

@media screen and (-ms-high-contrast:active), (forced-colors: active) {
  .ewa-dlb table.list-table td.list-item-selected { background-color: highlight; forced-color-adjust: none; color: highlighttext; }
}

.ewa-dpb { position: absolute; border: 1px solid rgb(162, 166, 171); cursor: default; background-color: rgb(255, 255, 255); color: rgb(68, 68, 68); font-size: 11px; z-index: 99; margin: 0px; max-width: 230px; }

.ewa-dpb p { padding: 0px 2px; margin: 0px; border-collapse: collapse; width: 230px; }

.ewa-dv-ltr .ewa-dpb p { text-align: left; }

.ewa-dv-rtl .ewa-dpb p { text-align: right; }

.ewa-dpb p.dv-prompt-title { font-weight: 700; }

.ewa-dpb p.dv-prompt-message { overflow-wrap: break-word; overflow: hidden; }
