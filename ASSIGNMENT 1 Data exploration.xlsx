.ewa-stb-tabs .tab-active { border-bottom: 2px solid rgb(33, 115, 70); margin: 2px 0px 3px; height: 20px; background-color: rgb(246, 246, 246); transform: translateX(0px); transition: transform 0.2s; }

.ewa-stb-uir .tab-active, .ewa-stb-uir .tab-inactive { background-color: rgb(245, 245, 245); border: 0px; margin: 0px; height: 32px; }

