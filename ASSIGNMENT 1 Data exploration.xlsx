.ewa-stb-uir .ewa-stb-right-scrollable.ewa-stb-contentarea::after { content: ""; position: absolute; top: 0px; left: 0px; pointer-events: none; background-image: linear-gradient(-90deg, rgb(220, 220, 220), transparent 1%); width: 100%; height: 32px; z-index: 1; }

.ewa-stb-invalid-sheetname-container { position: fixed; inset: 0px; z-index: -1; }

