.ewr-selection-draghandle-grab { position: absolute; background-color: rgb(255, 255, 255); opacity: 0.01; z-index: 15; pointer-events: auto; cursor: grab; }

.ewr-selection-draghandle-top { top: -2px; left: -2px; right: -2px; height: calc(1px + 4px / var(--zoom-level-canvas,1)); }

.ewr-selection-draghandle-bottom { right: 0px; left: -2px; bottom: calc(-1px - 2px / var(--zoom-level-canvas,1)); height: calc(1px + 2px / var(--zoom-level-canvas,1)); }

.ewr-selection-draghandle-left { top: 0px; left: calc(-1px - 1px / var(--zoom-level-canvas,1)); bottom: 0px; width: calc(1px + 5px / var(--zoom-level-canvas,1)); }

.ewr-selection-draghandle-right { top: 0px; right: -2px; bottom: 0px; width: calc(1px + 5px / var(--zoom-level-canvas,1)); }

.ewr-selection-drag-tooltip { position: absolute; background-color: rgb(255, 255, 255); box-shadow: rgba(0, 0, 0, 0.12) 0px 0px 2px 0px, rgba(0, 0, 0, 0.15) 0px 4px 8px 0px; outline: transparent solid 1px; border-radius: 4px; height: fit-content; width: max-content; font-size: 10px; padding: 4px 8px 6px; pointer-events: none; z-index: 53; left: 0px; top: 0px; font-family: "Segoe UI", "Segoe UI Web (West European)", "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, "Helvetica Neue", Calibri, Thonburi, Arial, Verdana, sans-serif, "Mongolian Baiti", "Microsoft Yi Baiti", "Javanese Text"; }

.ewr-selection-drag-tooltip-shift-instruction { font-style: italic; color: rgb(138, 136, 134); }

.ewa-root-ltr .ewr-selection-draghandle-reduced .ewr-selection-draghandle-right { width: calc(3px / var(--zoom-level-canvas,1)); }

.ewa-root-rtl .ewr-selection-draghandle-reduced .ewr-selection-draghandle-left { width: calc(3px / var(--zoom-level-canvas,1)); }

.ewr_selection_rearrangeleft { border-left: 3px solid rgb(16, 124, 65); position: absolute; height: 10px; width: 0px; left: -2px; top: -4px; }

.ewr_selection_rearrangeright { border-right: 3px solid rgb(16, 124, 65); position: absolute; height: 10px; width: 0px; right: -5px; top: -4px; }

.ewr_selection_rearrangetop { border-top: 3px solid rgb(16, 124, 65); position: absolute; width: 10px; height: 0px; top: -2px; left: -4px; }

.ewr_selection_rearrangebottom { border-bottom: 3px solid rgb(16, 124, 65); position: absolute; width: 10px; height: 0px; bottom: -5px; left: -4px; }

.ewr_selection_rearrange-flange-left, .ewr_selection_rearrange-fullrowcol-flange-left { border-left: 3px solid rgb(16, 124, 65); border-radius: 1.5px; position: absolute; height: 10px; width: 0px; left: -2px; top: -3.5px; }

.ewr_selection_rearrange-flange-right, .ewr_selection_rearrange-fullrowcol-flange-right { border-right: 3px solid rgb(16, 124, 65); border-radius: 1.5px; position: absolute; height: 10px; width: 0px; right: -5px; top: -3.5px; }

.ewr_selection_rearrange-flange-top, .ewr_selection_rearrange-fullrowcol-flange-top { border-top: 3px solid rgb(16, 124, 65); border-radius: 1.5px; position: absolute; width: 10px; height: 0px; top: -2px; left: -3.5px; }

.ewr_selection_rearrange-flange-bottom, .ewr_selection_rearrange-fullrowcol-flange-bottom { border-bottom: 3px solid rgb(16, 124, 65); border-radius: 1.5px; position: absolute; width: 10px; height: 0px; bottom: -5px; left: -3.5px; }

.ewr_selection_rearrange-fullrowcol-flange-left { left: 0px; }

.ewr_selection_rearrange-fullrowcol-flange-right { right: -3px; }

.ewr_selection_rearrange-fullrowcol-flange-top { top: 0px; }

.ewr_selection_rearrange-fullrowcol-flange-bottom { bottom: -3px; }

.ewr-cell-selection-highlight-all-after-fluent.selecting .ewr-selection-draghandle-grab { cursor: unset; }

.ewr-selection-drag-shadow { position: absolute; top: 0px; background-color: rgb(16, 124, 65); opacity: 0.15; z-index: 52; pointer-events: none; border-radius: 2px; }

.ewa-grid-ltr .ewr-selection-drag-shadow { left: 0px; }

.ewa-grid-rtl .ewr-selection-drag-shadow { right: 0px; }

@media (forced-colors: active) {
  .ewr-selection-drag-shadow { forced-color-adjust: none; background-color: rgb(255, 255, 255); opacity: 0.2; }
}

@media (forced-colors: active) and (prefers-color-scheme: light) {
  .ewr-selection-drag-shadow { background-color: rgb(0, 0, 0); }
}

.ewr-selection-resizemarqueehandle { position: absolute; width: 5px; height: 5px; background-color: rgb(16, 124, 65); border: 1px solid rgb(255, 255, 255); z-index: 16; pointer-events: auto; }

.ewr-selection-resizemarqueehandle-topleft, .ewr-selection-resizemarqueehandle-topright { top: -4px; }

.ewr-selection-resizemarqueehandle-bottomleft, .ewr-selection-resizemarqueehandle-bottomright { bottom: -4px; }

.ewr-grdcontarea-ltr .ewr-selection-resizemarqueehandle-bottomright, .ewr-grdcontarea-ltr .ewr-selection-resizemarqueehandle-topleft { cursor: nwse-resize; }

.ewr-grdcontarea-rtl .ewr-selection-resizemarqueehandle-bottomright, .ewr-grdcontarea-rtl .ewr-selection-resizemarqueehandle-topleft { cursor: nesw-resize; }

.ewr-grdcontarea-ltr .ewr-selection-resizemarqueehandle-bottomleft, .ewr-grdcontarea-ltr .ewr-selection-resizemarqueehandle-topright { cursor: nesw-resize; }

.ewr-grdcontarea-rtl .ewr-selection-resizemarqueehandle-bottomleft, .ewr-grdcontarea-rtl .ewr-selection-resizemarqueehandle-topright { cursor: nwse-resize; }

.ewr-grdcontarea-ltr .ewr-selection-resizemarqueehandle-bottomleft, .ewr-grdcontarea-ltr .ewr-selection-resizemarqueehandle-topleft, .ewr-grdcontarea-rtl .ewr-selection-resizemarqueehandle-bottomright, .ewr-grdcontarea-rtl .ewr-selection-resizemarqueehandle-topright { left: -4px; }

.ewr-grdcontarea-ltr .ewr-selection-resizemarqueehandle-bottomright, .ewr-grdcontarea-ltr .ewr-selection-resizemarqueehandle-topright, .ewr-grdcontarea-rtl .ewr-selection-resizemarqueehandle-bottomleft, .ewr-grdcontarea-rtl .ewr-selection-resizemarqueehandle-topleft { right: -4px; }

.ewr-marquee-thick { z-index: calc(11) !important; border-width: 3px !important; }

.ewr-grdcontarea-ltr .ewr-marquee-thick { margin: -3px 0px 0px -3px !important; }

.ewr-grdcontarea-rtl .ewr-marquee-thick { margin: -3px -3px 0px 0px !important; }

.ewr-resizemarqueehandle-thick { height: 6px !important; width: 6px !important; }
