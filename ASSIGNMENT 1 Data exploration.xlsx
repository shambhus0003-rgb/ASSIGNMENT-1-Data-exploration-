.ewa-nov2-ltr, .ewa-nov2-rtl, .msospAFrameContainerNov { inset: 0px; position: absolute; }

.msospAFrameContainerNov { display: block; margin: 0px; overflow: hidden; padding: 0px; }

.ewa-nov2-foreground { color: rgb(38, 38, 38); }

.ewa-nov2-viewport { inset: 49px 0px 0px; min-width: 700px; position: absolute; }

.ewa-nov2-content-panes { inset: 0px 40px; position: absolute; z-index: 10; }

.ewa-nov2-action-pane { background-color: rgb(33, 115, 70); bottom: 0px; color: rgb(255, 255, 255); position: absolute; top: 0px; width: 250px; z-index: 20; }

.ewa-nov2-ltr .ewa-nov2-action-pane { left: 40px; }

.ewa-nov2-rtl .ewa-nov2-action-pane { right: 40px; }

.ewa-nov2-slicersframe { height: 100%; margin: 0px; width: 100%; }

.ewa-nov2-focus { bottom: 0px; opacity: 0; position: absolute; top: 0px; }

.ewa-nov2-ltr .ewa-nov2-focus { left: 250px; right: 152px; }

.ewa-nov2-rtl .ewa-nov2-focus { left: 152px; right: 250px; }

.ewa-nov2-taskpane { background-color: rgb(255, 255, 255); bottom: 0px; cursor: default; position: absolute; top: 0px; user-select: none; width: 152px; z-index: 20; }

.ewa-nov2-taskpane.region-composer { position: relative; }

.ewa-nov2-ltr .ewa-nov2-taskpane { border-left: 1px solid rgb(225, 225, 225); }

.ewa-nov2-rtl .ewa-nov2-taskpane { border-right: 1px solid rgb(225, 225, 225); }

.ewa-nov2-taskpane.ewa-ee-taskpane { background-color: rgb(240, 240, 240); border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-right-width: medium; border-right-style: none; border-right-color: currentcolor; }

.ewa-nov2-ie8 .ewa-nov2-taskpane-transparency { }

.ewa-nov2-non-ie8 .ewa-nov2-taskpane-transparency { opacity: 0; }

.ewa-nov2-ltr .ewa-nov2-taskpane { right: 0px; }

.ewa-nov2-rtl .ewa-nov2-taskpane { left: 0px; }

.ewa-nov2-action-toolbar-container { background-color: rgb(7, 99, 49); bottom: 0px; opacity: 0; position: absolute; top: 0px; width: 40px; z-index: 30; }

.ewa-nov2-ltr .ewa-nov2-action-toolbar-container { left: 0px; }

.ewa-nov2-rtl .ewa-nov2-action-toolbar-container { right: 0px; }

.ewa-taskpane-toolbar-container { background-color: rgb(240, 240, 240); bottom: 0px; opacity: 0; overflow-y: auto; position: absolute; top: 0px; width: 40px; z-index: 30; }

.ewa-nov2-ltr .ewa-taskpane-toolbar-container { right: 0px; }

.ewa-nov2-rtl .ewa-taskpane-toolbar-container { left: 0px; }

.ewa-taskpane-toolbar-container.region-composer { position: relative; }

.ewa-nov2-header { border-bottom: 1px solid rgb(225, 225, 225); color: rgb(119, 119, 119); font-size: 112.5%; height: 48px; overflow: hidden; width: 100%; }

.ewa-nov2-header a { text-decoration: none; }

.ewa-nov2-zone-header { height: 64px; left: 0px; position: absolute; right: 0px; top: 0px; }

.ewa-nov2-zone-body { inset: 0px 0px 40px; filter: inherit; overflow: hidden auto; position: absolute; }

.ewa-nov2-focus .ewa-nov2-zone-body { inset: 64px 40px 40px; }

.ewa-nov2-slicers-body { bottom: 0px; overflow-x: hidden; position: absolute; top: 66px; }

.ewa-nov2-ltr .ewa-nov2-slicers-body { padding-right: 25px; }

.ewa-nov2-rtl .ewa-nov2-slicers-body { padding-left: 25px; }

.ewa-nov2-slicer-collapse, .ewa-nov2-slicer-expand, .ewa-nov2-taskpane-collapse, .ewa-nov2-taskpane-expand { cursor: pointer; }

.ewa-nov2-slicer-collapse-container, .ewa-nov2-slicer-expand-container, .ewa-nov2-taskpane-collapse-container, .ewa-nov2-taskpane-expand-container { padding: 10px; position: absolute; top: 14px; z-index: 40; }

.ewa-nov2-ltr .ewa-nov2-slicer-collapse-container, .ewa-nov2-ltr .ewa-nov2-taskpane-collapse-container, .ewa-nov2-ltr .ewa-nov2-taskpane-expand-container { right: 5px; }

.ewa-nov2-rtl .ewa-nov2-slicer-collapse-container, .ewa-nov2-rtl .ewa-nov2-taskpane-collapse-container, .ewa-nov2-rtl .ewa-nov2-taskpane-expand-container { left: 5px; }

.ewa-nov2-slicer-expand-container, .ewa-taskpane-toolbar-container .ewa-nov2-taskpane-collapse-container, .ewa-taskpane-toolbar-container .ewa-nov2-taskpane-expand-container { right: 2px; }

.ewa-nov2-slicer-collapse:hover .ewanov_chevronLeftFilter, .ewa-nov2-slicer-expand:hover .ewanov_chevronRightFilter, .ewa-nov2-taskpane-collapse:hover .ewanov_chevronRightView, .ewa-nov2-taskpane-expand:hover .ewanov_chevronLeftView { margin-top: -16px; }

.ewa-nov2-pane-title, .ewa-nov2-zone-label { cursor: default; font-weight: lighter; margin-top: 12px; overflow: hidden; white-space: nowrap; }

.ewa-nov2-zone-label { text-overflow: ellipsis; }

.ewa-nov2-pane-title { margin-bottom: 18px; position: absolute; text-overflow: clip; }

.ewa-nov2-taskpane .ewa-nov2-pane-title { color: rgb(102, 102, 102); }

.ewa-nov2-ltr .ewa-nov2-pane-title { right: 25px; text-align: left; }

.ewa-nov2-rtl .ewa-nov2-pane-title { left: 25px; text-align: right; }

.ewa-nov2-ltr .ewa-nov2-taskpane .ewa-nov2-pane-title { left: 17px; }

.ewa-nov2-rtl .ewa-nov2-taskpane .ewa-nov2-pane-title { right: 17px; }

.ewa-nov2-ltr .ewa-nov2-action-pane .ewa-nov2-pane-title { left: 13px; }

.ewa-nov2-rtl .ewa-nov2-action-pane .ewa-nov2-pane-title { right: 13px; }

.ewa-nov2-taskpane .ewa-nov2-taskpane-container { inset: 0px; position: absolute; }

.ewa-nov2-ltr .ewa-nov2-taskpane .ewa-nov2-taskpane-container { padding-left: 17px; padding-right: 15px; }

.ewa-nov2-rtl .ewa-nov2-taskpane .ewa-nov2-taskpane-container { padding-left: 15px; padding-right: 17px; }

.ewa-nov2-tp-container { height: 100%; position: absolute; width: 100%; }

.ewa-nov2-tp-btgrup { inset: 64px 0px 0px; position: absolute; }

.ewa-nov2-tp-bt { cursor: pointer; display: block; height: 32px; left: 0px; margin-bottom: 5px; position: relative; right: 0px; }

.ewa-taskpane-toolbar-container .ewa-nov2-tp-bt-active { background-color: rgb(255, 255, 255); }

.ewa-nov2-action-toolbar-container .ewa-nov2-tp-bt-active { background-color: rgb(33, 115, 70); }

.cui-disabled .ewa-nov2-tp-bt-img-ct.cui-img-container { background-color: initial; }

.usehover .ewa-taskpane-toolbar-container .ewa-nov2-tp-bt:hover { background-color: rgb(225, 225, 225); }

.usehover .ewa-nov2-action-toolbar-container .ewa-nov2-tp-bt:hover { background-color: rgb(67, 148, 103); }

.ewa-taskpane-toolbar-container .ewa-nov2-tp-bt.ewa-nov2-tp-bt-enabled:active { background-color: rgb(198, 198, 198); }

.ewa-nov2-action-toolbar-container .ewa-nov2-tp-bt.ewa-nov2-tp-bt-enabled:active { background-color: rgb(10, 99, 50); }

.ewa-nov2-do-more-pane, .ewa-nov2-options-pane, .ewa-nov2-slicers-pane { inset: 0px; padding: 0px 13px; position: absolute; z-index: 20; }

.clip24x24.ewa-nov2-tp-bt-img-ct { bottom: 4px; position: absolute; right: 8px; }

.ewa-nov2-pickerpane, .ewa-nov2-pickerpane-content { height: 100%; position: absolute; }

.ewa-nov2-pickerpane-content { filter: inherit; width: 106px; }

.ewa-nov2-pickerpane-scroll { bottom: 0px; filter: inherit; overflow: hidden auto; position: absolute; top: 66px; width: 123px; }

.ewa-nov2-thumbnail { filter: inherit; overflow: hidden; }

.ewa-nov2-thumbnail-sel { border: 2px solid rgb(33, 115, 70); }

.ewa-nov2-thumbnail-sel, .ewa-nov2-thumbnail-unsel { list-style-type: none; max-height: 202px; max-width: 102px; }

.ewa-nov2-thumbnail-unsel { border: 2px solid rgba(0, 0, 0, 0); cursor: pointer; }

.ewa-nov2-thumbnail-img { filter: inherit; margin: 1px; max-height: 200px; max-width: 100px; min-height: 17px; overflow: hidden; }

.ewa-nov2-thumbnail-label { color: rgb(68, 68, 68); filter: inherit; font-weight: 700; line-height: 9px; overflow: hidden; padding-bottom: 15px; padding-top: 3px; text-overflow: ellipsis; white-space: nowrap; }

.ewa-nov2-thumbnail-label-text { cursor: pointer; display: inline-block; line-height: 9px; }

.ewa-nov2-thumbnail-img input { filter: inherit; }

div.ewa-nov2-ewaContainer { bottom: 0px; margin-left: auto; margin-right: auto; position: absolute; top: 0px; }

.ewa-nov2-focus-label { color: rgb(33, 115, 70); font-size: 15.5pt; margin-left: 40px; margin-right: 40px; padding-top: 4px; }

iframe.ewr-nov2-slicer-container { inset: 0px; width: 100%; }

.ewa-nov2-toolbar-adjustment { border: 1px solid rgb(66, 66, 66); }

.ewa-nov2-toolbar-dock-adjustment { margin-top: 0px !important; }

.ewa-nov2-toolbar-button-text { text-transform: uppercase; }

.ewa-nov2-about-logo { height: 30px; overflow: hidden; width: 135px; }

.ewa-nov2-animation-loading-container { background-color: rgb(255, 255, 255); text-align: center; vertical-align: middle; z-index: 200; }

.ewa-nov2-animation-loading-text { color: rgb(102, 102, 102); font-size: 10.5pt; position: absolute; text-align: center; top: 50%; width: 100%; }

.ewa-nov2-animation-loading-image { padding-right: 3px; vertical-align: middle; }

.ewa-nov2-animation-loading-imagetext { vertical-align: top; }

.ewa-nov2-animation-hidden-div { height: 1000px; left: -20000px; position: absolute; top: -20000px; width: 1000px; }

.ewafo-slicer { overflow: visible; z-index: 50; }

.ewa-fo-img-div-slicer { height: 100%; left: 0px; overflow: hidden; top: 0px; width: 100%; }

.ewa-nov2-noslicer-message { font-weight: 700; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.ewa-ee-taskpane .ewa-nov2-pickerpane-scroll.ewa-scrollbars { }

.ewa-nov2-toolbar-list { color: rgb(255, 255, 255); font-size: 11pt; left: 13px; list-style-type: none; margin: 0px; padding: 0px; position: absolute; right: 13px; top: 66px; }

.ewa-nov2-ltr .ewa-nov2-toolbar-list { text-align: left; }

.ewa-nov2-rtl .ewa-nov2-toolbar-list { text-align: right; }

.ewa-nov2-toolbar-menu-element { cursor: pointer; padding: 10px 2px; }

.usehover .ewa-nov2-toolbar-menu-element-enabled:hover { background-color: rgb(67, 148, 103); }

.ewa-nov2-toolbar-menu-element-enabled:active { background-color: rgb(10, 99, 50) !important; }

.ewa-nov2-toolbar-menu-element-disabled { color: rgb(177, 177, 177); cursor: default; }

.ewa-nov2-toolbar-menu-icon { display: inline-block; }

.ewa-nov2-ltr .ewa-nov2-toolbar-menu-icon { margin-right: 6px; }

.ewa-nov2-rtl .ewa-nov2-toolbar-menu-icon { margin-left: 6px; }

.ewa-nov2-toolbar-menu-label { position: relative; top: -3px; }

.ewa-nov2-options-link-container { bottom: 0px; position: absolute; }

.ewa-nov2-ltr .ewa-nov2-options-link-container { text-align: left; }

.ewa-nov2-rtl .ewa-nov2-options-link-container { text-align: right; }

.ewa-nov2-options-link { color: rgb(255, 255, 255); text-decoration: none; }

.usehover .ewa-nov2-options-link:hover { text-decoration: underline; }

.ewa-ptp-nov2 { border-left-width: medium; border-left-style: none; border-left-color: currentcolor; border-right-width: medium; border-right-style: none; border-right-color: currentcolor; }

.ewa-ptp-nov2-flex { display: flex; flex-direction: column; }

.ewa-flp-ltr.ewa-flp-nov2, .ewa-ptp-ltr.ewa-ptp-nov2 { bottom: 0px; left: 19px; right: auto; }

.ewa-flp-rtl.ewa-flp-nov2, .ewa-ptp-rtl.ewa-ptp-nov2 { bottom: 0px; left: auto; right: 19px; }

.ewa-flp-nov2 .ewa-flp-description, .ewa-ptp-nov2 .ewa-ptp-title { color: rgb(102, 102, 102); font-weight: lighter; }

.ewa-ptp-nov2 .ewa-ptp-title { font-size: 21px; padding: 9px 8px 6px; }

.ewa-ptp-nov2 .ewa-ptp-title-maker { color: rgb(37, 35, 33); font-size: 16pt; padding: 16px; }

.ewa-ptp-nov2 .ewa-ptp-title-maker-react { color: rgb(37, 36, 35); font-size: 16px; font-weight: 600; padding: 6px 0px 0px; }

.ewa-ptp-nov2 .ewa-ptp-title-ideas, .ewa-ptp-nov2 .ewa-ptp-title-navigation, .ewa-ptp-nov2-flex .ewa-ptp-title-ideas, .ewa-ptp-nov2-flex .ewa-ptp-title-navigation { color: rgb(51, 51, 51); font-size: 16px; font-weight: 600; padding: 5px 0px 0px; }

.ewa-flp-nov2 .ewa-flp-description { font-size: 19.5pt; padding: 9px 0px 6px; }

.ewa-flp-nov2 .ewa-flp-fieldmanager { top: 52px; }

.ewa-nov2-ltr .cui-QATRowLeft { left: 0px; position: absolute; right: auto; top: 0px; }

.ewa-nov2-rtl .cui-QATRowLeft { left: auto; position: absolute; right: 0px; top: 0px; }

.ewa-nov2-tp-resize-button { background-color: initial; border: rgba(0, 0, 0, 0); bottom: 0px; height: 32px; left: 0px; margin-bottom: auto; margin-left: -16px; margin-top: auto; padding: 0px; position: absolute; top: 0px; width: 32px; }

.ewa-nov2-tp-resize-handle { cursor: col-resize; height: 100%; left: -5px; position: absolute; user-select: none; width: 15px; }

.ewaLegacyTaskPaneRegionComposer { display: flex; flex-direction: row-reverse; height: 100%; }

.ewa-nov2-animation-loading-text, .ewa-nov2-ltr, .ewa-nov2-rtl, .ewa-nov2-toolbar-adjustment, .msospAFrameContainerNov { font-family: "Segoe UI", Tahoma, Thonburi, Arial, Verdana, sans-serif; }

.msospAFrameContainerNov { font-size: 8pt; }

.ewa-nov2-pane-title, .ewa-nov2-zone-label { font-size: 19.5pt; }

.ewa-nov2-thumbnail-label { font-size: 8pt; }

.ewa-nov2-noslicer-message { font-size: 10pt; }
