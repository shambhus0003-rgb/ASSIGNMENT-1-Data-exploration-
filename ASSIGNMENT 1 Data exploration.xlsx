.ewa-note { width: 210px; height: 150px; border: 1px solid rgb(0, 0, 0); background-color: rgb(255, 255, 225); resize: none; overflow: visible; }

.ewa-note-active { z-index: 2; }

.ewa-note-textarea { display: block; margin: 0px; height: 100%; width: 100%; box-sizing: border-box; background-color: rgb(255, 255, 225); resize: none; padding: 2px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; pointer-events: auto; }

.ewa-notes-container { position: relative; z-index: 51; pointer-events: none; top: 0px; left: 0px; }

.ewa-err-wrapper { position: absolute; z-index: 29; width: 100%; height: 100%; max-height: 20px; max-width: 20px; }

.ewa-err-notch { position: absolute; width: 0px; height: 0px; border: 4px solid; transition: border-width 0.1s ease-in; }

.ewa-err-wrapper:hover > .ewa-err-notch { border-width: 6px; }

.ewr-grdcontarea-ltr .ewa-err-notch { border-color: rgb(21, 103, 18) transparent transparent rgb(21, 103, 18); }

.ewr-grdcontarea-rtl .ewa-err-notch { border-color: rgb(21, 103, 18) rgb(21, 103, 18) transparent transparent; }

@media screen and (-ms-high-contrast:active), (forced-colors: active) {
  .ewr-grdcontarea-ltr .ewa-err-notch { forced-color-adjust: none; border-color: rgb(255, 255, 255) transparent transparent rgb(255, 255, 255); }
  .ewr-grdcontarea-rtl .ewa-err-notch { forced-color-adjust: none; border-color: rgb(255, 255, 255) rgb(255, 255, 255) transparent transparent; }
}

@media screen and (-ms-high-contrast:black-on-white), (forced-colors: active) and (prefers-color-scheme: light) {
  .ewr-grdcontarea-ltr .ewa-err-notch { forced-color-adjust: none; border-color: rgb(0, 0, 0) transparent transparent rgb(0, 0, 0); }
  .ewr-grdcontarea-rtl .ewa-err-notch { forced-color-adjust: none; border-color: rgb(0, 0, 0) rgb(0, 0, 0) transparent transparent; }
}

@font-face { font-family: XLYellow; src: url("https://fs.microsoft.com/fs/RichValueIcons/3.29/rawguids/Yellow.woff") format("woff"); }

.ewr-richvalueicon { position: absolute; margin: inherit; border: 0px; display: block; font-family: XLYellow; z-index: 28; cursor: pointer; padding: 0px; }

